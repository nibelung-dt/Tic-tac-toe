<?xml version="1.0" encoding="utf-8"?>
<!--
    Разрешаем cleartext (HTTP) ТОЛЬКО для локальной разработки.
    Всё остальное — только HTTPS. Это отключает блокировку из Android 9+,
    не открывая дыру для продовых хостов.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- Эмулятор: алиас хост-машины -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <!-- Физическое устройство через `adb reverse tcp:8080 tcp:8080` -->
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
